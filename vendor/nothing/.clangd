# Prefer the compilation database generated by CMake. It contains the correct
# include paths and flags for the current checkout, so moving the project only
# requires re-running CMake.
CompileFlags:
  CompilationDatabase: build
  # Fallback for the first configure, or when the build directory is absent.
  # clangd's fallback working directory is the source file's directory, so
  # ../include resolves to <project>/include from src/, tests/ and examples/.
  Add:
    - -I../include
    - -std=c11
    - -D_DEFAULT_SOURCE
    - -D_POSIX_C_SOURCE=200809L
