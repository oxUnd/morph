+void mjx_parse_opts_cleanup(mjx_parse_opts* opts) {
+  if (!opts) return;
+  if (opts->owns_options) {
+    mjx_factory_destroy(opts->factory);
+    if (opts->macros) {
+      for (size_t i = 0; i < opts->macro_count; i++)
+        mjx_macro_destroy(opts->macros[i]);
+    }
+    free(opts->macros);
+    free(opts->operators);
+    if (opts->env_names) {
+      for (size_t i = 0; i < opts->env_count; i++)
+        free((void*)opts->env_names[i]);
+    }
+    free(opts->env_names);
+    free(opts->env_handlers);
+  }
+  memset(opts, 0, sizeof(*opts));
+}
+
 mjx_parser* mjx_parser_create(mjx_parse_opts* opts) {
+  if (opts && ((opts->macro_count && !opts->macros) ||
+               (opts->operator_count && !opts->operators) ||
+               (opts->env_count && (!opts->env_names || !opts->env_handlers))))
+    return NULL;
   mjx_parser* parser = (mjx_parser*)calloc(1, sizeof(mjx_parser));
   if (!parser) return NULL;
-  if (opts) parser->opts = *opts;
+  if (opts) {
+    parser->opts = *opts;
+    if (opts->owns_options) {
+      parser->owns_macro_array = 1;
+      parser->owns_environment_arrays = 1;
+      memset(opts, 0, sizeof(*opts));
+    } else {
+      parser->borrowed_macros = opts->macro_count;
+      parser->borrowed_environments = opts->env_count;
+    }
+  }
   return parser;
 }
 
 void mjx_parser_destroy(mjx_parser* parser) {
   if (!parser) return;
   if (parser->result) mjx_node_destroy(parser->result);
+  if (!parser->opts.owns_options) {
+    for (size_t i = parser->borrowed_macros; i < parser->opts.macro_count; i++)
+      mjx_macro_destroy(parser->opts.macros[i]);
+    for (size_t i = parser->borrowed_environments; i < parser->opts.env_count; i++)
+      free((void*)parser->opts.env_names[i]);
+    if (parser->owns_macro_array) free(parser->opts.macros);
+    if (parser->owns_environment_arrays) {
+      free(parser->opts.env_names);
+      free(parser->opts.env_handlers);
+    }
+  }
+  mjx_parse_opts_cleanup(&parser->opts);
   free(parser);
 }
 
