+						   "sqlite:///:memory:") };
+	struct norm_db *db = NULL;
+	struct norm_conn *conn = NULL;
+	struct norm_rows *rows = NULL;
+	const struct scalar_row value = { .value = 20 };
+	const struct norm_assignment assignment = {
+		.column = norm_col(&temporary_model, 0),
+		.value = norm_i64(30),
+	};
+	const struct norm_update_query update = {
+		.set = &assignment,
+		.set_count = 1,
+		.allow_all_rows = true,
+	};
+	const struct norm_delete_query deletion = { .allow_all_rows = true };
+	const struct scalar_row *row;
+
+	OK(norm_db_open(&options, &db, &error));
+	OK(norm_db_acquire(db, NULL, &conn, &error));
+	execute(conn, "CREATE TABLE main.temporary_items(value INTEGER)");
+	execute(conn, "INSERT INTO main.temporary_items VALUES(10)");
+	OK(norm_schema_create(conn, &temporary_model, NULL, NULL, &error));
+	OK(norm_insert(conn, &temporary_model, &value, NULL, NULL, NULL,
+		       &error));
+	OK(norm_select(conn, &temporary_model, NULL, NULL, &rows, &error));
+	REQUIRE(norm_rows_count(rows) == 1);
+	row = norm_rows_at(rows, 0);
+	REQUIRE(row->value == 20);
+	norm_rows_free(rows);
+	rows = NULL;
+	OK(norm_update(conn, &temporary_model, &update, NULL, NULL, &error));
+	REQUIRE(query(conn, "SELECT value FROM temp.temporary_items", NULL,
+		      0) == 30);
+	REQUIRE(query(conn, "SELECT value FROM main.temporary_items", NULL,
+		      0) == 10);
+	REQUIRE(query(conn,
+		      "SELECT count(*) AS value FROM sqlite_temp_schema "
+		      "WHERE type='index' AND name='temporary_value'",
+		      NULL, 0) == 1);
+	OK(norm_delete(conn, &temporary_model, &deletion, NULL, NULL, &error));
+	REQUIRE(query(conn,
+		      "SELECT count(*) AS value FROM temp.temporary_items",
+		      NULL, 0) == 0);
+	OK(norm_schema_drop(conn, &temporary_model, false, NULL, &error));
+	REQUIRE(query(conn,
+		      "SELECT count(*) AS value FROM sqlite_temp_schema "
