+static const char *sqlite_script_word(const char *text, nb_str *word)
+{
+	text = sqlite_tail(text);
+	const char *start = text;
+
+	while (isalpha((unsigned char)*text))
+		text++;
+	*word = nb_str_from_parts(start, (size_t)(text - start));
+	return text;
+}
+
+static nb_status sqlite_script_statement(struct norm_conn *conn, nb_str sql,
+					 const struct norm_call *call,
+					 struct norm_error *error)
+{
+	nb_str first, second;
+	const char *tail = sqlite_script_word(sql.ptr, &first);
+
+	if (nb_str_eq_icase(first, NB_STR_LIT("BEGIN"))) {
+		struct norm_tx_options options = { 0 };
+
+		sqlite_script_word(tail, &second);
+		if (nb_str_eq_icase(second, NB_STR_LIT("IMMEDIATE")))
+			options.sqlite_mode = NORM_SQLITE_IMMEDIATE;
+		else if (nb_str_eq_icase(second, NB_STR_LIT("EXCLUSIVE")))
+			options.sqlite_mode = NORM_SQLITE_EXCLUSIVE;
+		return norm_tx_begin(conn, &options, call, error);
+	}
+	if (nb_str_eq_icase(first, NB_STR_LIT("COMMIT")) ||
+	    nb_str_eq_icase(first, NB_STR_LIT("END")))
+		return norm_tx_commit(conn, call, error);
+	if (nb_str_eq_icase(first, NB_STR_LIT("ROLLBACK"))) {
+		sqlite_script_word(tail, &second);
+		if (!nb_str_eq_icase(second, NB_STR_LIT("TO")))
+			return norm_tx_rollback(conn, call, error);
+	}
+	if (!nb_str_eq_icase(first, NB_STR_LIT("SAVEPOINT")) &&
+	    !nb_str_eq_icase(first, NB_STR_LIT("RELEASE")) &&
+	    !nb_str_eq_icase(first, NB_STR_LIT("ROLLBACK"))) {
+		nb_status ret = norm_validate_raw_sql(
+			NORM_DRIVER_SQLITE, sql,
+			norm_tx_get_state(conn) != NORM_TX_IDLE, error);
+
+		if (ret != NB_OK)
+			return ret;
+	}
+	return norm_exec_internal(conn, sql, NULL, 0, call, NULL, error);
+}
+
+nb_status norm_sqlite_exec_script(struct norm_conn *conn, nb_str script,
+				  const struct norm_call *call,
+				  struct norm_error *error)
+{
+	struct norm_sqlite_connection *connection;
+	char *text;
+	const char *cursor;
+	nb_status ret;
+
+	if (!script.ptr || script.len >= INT_MAX ||
+	    memchr(script.ptr, 0, script.len) || !nb_utf8_valid(script))
+		return sqlite_extension_error(error, NB_ERR_INVAL,
+					      "invalid SQLite script");
+	ret = sqlite_extension_connection(conn, call, false, &connection,
+					  error);
+	if (ret != NB_OK)
+		return ret;
+	text = norm_str_dup(script);
+	if (!text)
+		return sqlite_extension_error(error, NB_ERR_NOMEM,
+					      "copying SQLite script");
+	cursor = text;
+	while (*cursor && ret == NB_OK) {
+		sqlite3_stmt *statement = NULL;
+		const char *tail = NULL;
+		int rc;
+
+		ret = norm_check_call(call, error);
+		if (ret != NB_OK)
+			break;
+		rc = sqlite3_prepare_v2(connection->db, cursor, -1, &statement,
+					&tail);
+		if (rc != SQLITE_OK) {
+			ret = sqlite_error(connection, rc,
+					   NORM_OUTCOME_NOT_EXECUTED, error);
+			sqlite3_finalize(statement);
+			break;
+		}
+		if (!tail || tail <= cursor) {
+			sqlite3_finalize(statement);
+			break;
+		}
+		if (statement) {
+			nb_str sql = nb_str_from_parts(cursor,
+						       (size_t)(tail - cursor));
+
+			sqlite3_finalize(statement);
+			ret = sqlite_script_statement(conn, sql, call, error);
+		}
+		cursor = tail;
+	}
+	norm_dealloc(text);
+	return ret;
+}
+
+static nb_status
+sqlite_clear_attached(struct norm_sqlite_connection *connection,
+		      struct norm_error *error)
+{
+	sqlite3_stmt *statement = NULL;
+	nb_vec names;
+	nb_status ret = NB_OK;
+	int rc;
+	size_t i;
+
+	nb_vec_init(&names, sizeof(char *));
+	rc = sqlite3_prepare_v2(connection->db, "PRAGMA database_list", -1,
+				&statement, NULL);
+	if (rc != SQLITE_OK)
+		ret = sqlite_error(connection, rc, NORM_OUTCOME_NOT_EXECUTED,
+				   error);
+	while (ret == NB_OK && (rc = sqlite3_step(statement)) == SQLITE_ROW) {
+		const char *name =
+			(const char *)sqlite3_column_text(statement, 1);
+		char *owned;
+
+		if (!strcmp(name, "main") || !strcmp(name, "temp"))
+			continue;
+		owned = norm_str_dup(nb_str_from_cstr(name));
+		if (!owned || !nb_vec_push_copy(&names, &owned)) {
+			norm_dealloc(owned);
+			ret = sqlite_extension_error(
+				error, NB_ERR_NOMEM,
+				"collecting attached databases");
+		}
+	}
+	if (ret == NB_OK && rc != SQLITE_DONE)
+		ret = sqlite_error(connection, rc, NORM_OUTCOME_NOT_EXECUTED,
+				   error);
+	sqlite3_finalize(statement);
+	for (i = 0; i < names.len; i++) {
+		char *name = *(char **)nb_vec_at(&names, i);
+		char *sql = sqlite3_mprintf("DETACH DATABASE \"%w\"", name);
+
+		if (ret == NB_OK)
+			ret = sql ? sqlite_command(connection, sql, error)
+				  : sqlite_extension_error(
+					    error, NB_ERR_NOMEM,
+					    "allocating detach SQL");
+		sqlite3_free(sql);
+		norm_dealloc(name);
+	}
+	nb_vec_destroy(&names);
+	return ret;
+}
