+static void test_computed_query_dialects(void)
+{
+	const enum norm_driver drivers[] = { NORM_DRIVER_SQLITE,
+					     NORM_DRIVER_MYSQL,
+					     NORM_DRIVER_POSTGRESQL };
+	struct norm_term left = norm_term_value(
+		norm_text(NB_STR_LIT("x');DROP TABLE users;--")));
+	struct norm_term right = norm_term_value(norm_null());
+	struct norm_query_field field = { .value = norm_term_value(norm_i64(7)),
+					  .into = SAMPLE_COUNT };
+	struct norm_query query = {
+		.projection = &sample_model,
+		.fields = &field,
+		.field_count = 1,
+		.where = norm_compare_terms(&left, NORM_COMPARE_IS_NOT, &right)
+	};
+	struct norm_sql sql;
+
+	for (size_t i = 0; i < NB_ARRAY_SIZE(drivers); i++) {
+		norm_sql_init(&sql);
+		assert(norm_compile_query(drivers[i], &query, &sql, NULL) ==
+		       NB_OK);
+		assert(sql.params.len == 3);
+		assert(!strstr(nb_buf_cstr(&sql.text), "DROP TABLE"));
+		if (drivers[i] == NORM_DRIVER_MYSQL)
+			assert(strstr(nb_buf_cstr(&sql.text), "NOT (? <=> ?)"));
+		if (drivers[i] == NORM_DRIVER_POSTGRESQL)
+			assert(strstr(nb_buf_cstr(&sql.text),
+				      "$2 IS DISTINCT FROM $3"));
+		norm_sql_destroy(&sql);
+	}
+	field.value = norm_term_call(NORM_FUNCTION_SUM, NULL, 0);
+	norm_sql_init(&sql);
+	assert(norm_compile_query(NORM_DRIVER_SQLITE, &query, &sql, NULL) ==
+	       NB_ERR_INVAL);
+	norm_sql_destroy(&sql);
+	field.value = norm_term_value(norm_i64(7));
+	query.where = norm_compare_terms(NULL, NORM_COMPARE_EQ, &right);
+	norm_sql_init(&sql);
+	assert(norm_compile_query(NORM_DRIVER_SQLITE, &query, &sql, NULL) ==
+	       NB_ERR_INVAL);
+	norm_sql_destroy(&sql);
+}
+
 int main(void)
 {
+	test_computed_query_dialects();
 	test_parameterization();
 	test_null_and_empty_set();
 	test_atomic_insert_shape();
