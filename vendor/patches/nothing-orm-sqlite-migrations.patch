+/* Structured computed queries. Every value is bound; names are identifiers. */
+#ifndef NORM_QUERY_H
+#define NORM_QUERY_H
+
+#include <norm/orm.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum norm_term_kind {
+	NORM_TERM_COLUMN = 0,
+	NORM_TERM_VALUE,
+	NORM_TERM_BINARY,
+	NORM_TERM_FUNCTION,
+	NORM_TERM_CASE,
+	NORM_TERM_CAST,
+	NORM_TERM_SCALAR_QUERY,
+	NORM_TERM_EXCLUDED,
+	NORM_TERM_ROWID,
+	NORM_TERM_ROW_NUMBER
+};
+
+enum norm_binary {
+	NORM_BINARY_ADD = 0,
+	NORM_BINARY_SUBTRACT,
+	NORM_BINARY_MULTIPLY,
+	NORM_BINARY_DIVIDE,
+	NORM_BINARY_CONCAT
+};
+
+enum norm_function {
+	NORM_FUNCTION_COUNT = 0,
+	NORM_FUNCTION_SUM,
+	NORM_FUNCTION_MIN,
+	NORM_FUNCTION_MAX,
+	NORM_FUNCTION_COALESCE,
+	NORM_FUNCTION_LENGTH,
+	NORM_FUNCTION_BYTE_LENGTH,
+	NORM_FUNCTION_LOWER,
+	NORM_FUNCTION_SUBSTR,
+	NORM_FUNCTION_NULLIF,
+	NORM_FUNCTION_TYPEOF,
+	NORM_FUNCTION_JSON_EXTRACT,
+	NORM_FUNCTION_GREATEST,
+	NORM_FUNCTION_LEAST,
+	NORM_FUNCTION_CURRENT_EPOCH,
+	NORM_FUNCTION_UTC_DAY,
+	NORM_FUNCTION_NAMED
+};
+
+struct norm_query;
+struct norm_term;
+struct norm_query_order;
+
+struct norm_case {
+	struct norm_expr when;
+	const struct norm_term *then;
+};
+
+struct norm_window {
+	const struct norm_term *partition;
+	size_t partition_count;
+	const struct norm_query_order *order;
+	size_t order_count;
+};
+
+/* All nodes borrow their children. A synchronous operation compiles/copies
+ * everything except model descriptors before it returns, including cursors. */
+struct norm_term {
+	enum norm_term_kind kind;
+	union {
+		struct norm_column column;
+		struct norm_value value;
+		struct {
+			enum norm_binary operation;
+			const struct norm_term *left;
+			const struct norm_term *right;
+		} binary;
+		struct {
+			enum norm_function function;
+			nb_str name;
+			const struct norm_term *arguments;
+			size_t count;
+			bool distinct;
+		} function;
+		struct {
+			const struct norm_case *branches;
+			size_t count;
+			const struct norm_term *otherwise;
+		} conditional;
+		struct {
+			const struct norm_term *value;
+			enum norm_type type;
+		} cast;
+		const struct norm_query *query;
+		const struct norm_table_ref *rowid;
+		struct norm_window window;
+	} as;
+};
+
+struct norm_query_field {
+	struct norm_term value;
+	size_t into;
+};
+
+struct norm_query_order {
+	struct norm_term value;
+	enum norm_sort_direction direction;
+	enum norm_null_order nulls;
+};
+
+struct norm_cte {
+	/* schema must be empty; table and fields name this CTE and its columns.
+	 */
+	const struct norm_model *model;
+	const struct norm_query *query;
+	bool recursive;
+};
+
+enum norm_set_operation {
+	NORM_SET_UNION = 0,
+	NORM_SET_UNION_ALL
+};
+
+struct norm_query_set {
+	enum norm_set_operation operation;
+	const struct norm_query *query;
+};
+
+struct norm_query {
+	const struct norm_cte *with;
+	size_t with_count;
+	/* NULL permits a SELECT of values, including conditional insert-select.
+	 */
+	const struct norm_table_ref *from;
+	const struct norm_join *joins;
+	size_t join_count;
+	const struct norm_model *projection;
+	const struct norm_query_field *fields;
+	size_t field_count;
+	struct norm_expr where;
+	bool distinct;
+	const struct norm_term *group;
+	size_t group_count;
+	struct norm_expr having;
+	const struct norm_query_set *sets;
+	size_t set_count;
+	const struct norm_query_order *order;
+	size_t order_count;
+	bool has_limit;
+	uint64_t limit;
+	uint64_t offset;
+	const struct norm_result_options *result_options;
+};
+
+enum norm_conflict_action {
+	NORM_CONFLICT_NOTHING = 0,
+	NORM_CONFLICT_UPDATE
+};
+
+struct norm_conflict {
+	enum norm_conflict_action action;
+	const size_t *fields;
+	size_t field_count;
+	const struct norm_assignment *set;
+	size_t set_count;
+	struct norm_expr where;
+};
+
+NORM_EXPORT struct norm_term norm_term_column(struct norm_column column);
+NORM_EXPORT struct norm_term norm_term_value(struct norm_value value);
+NORM_EXPORT struct norm_term norm_term_binary(enum norm_binary operation,
+					      const struct norm_term *left,
+					      const struct norm_term *right);
+NORM_EXPORT struct norm_term norm_term_call(enum norm_function function,
+					    const struct norm_term *arguments,
+					    size_t count);
+/* A named function is one quoted identifier, never SQL text. */
+NORM_EXPORT struct norm_term
+norm_term_named_call(nb_str name, const struct norm_term *arguments,
+		     size_t count);
+NORM_EXPORT struct norm_term norm_term_case(const struct norm_case *branches,
+					    size_t count,
+					    const struct norm_term *otherwise);
+NORM_EXPORT struct norm_term norm_term_cast(const struct norm_term *value,
+					    enum norm_type type);
+NORM_EXPORT struct norm_term norm_term_scalar(const struct norm_query *query);
+NORM_EXPORT struct norm_term norm_term_excluded(struct norm_column column);
+NORM_EXPORT struct norm_term
+norm_term_rowid(const struct norm_table_ref *source);
+NORM_EXPORT struct norm_term norm_term_row_number(struct norm_window window);
+NORM_EXPORT struct norm_expr norm_compare_terms(const struct norm_term *left,
+						enum norm_compare operation,
+						const struct norm_term *right);
+NORM_EXPORT struct norm_expr norm_exists(const struct norm_query *query);
+NORM_EXPORT struct norm_expr norm_in_query(const struct norm_term *value,
+					   const struct norm_query *query,
+					   bool negated);
+
+NORM_EXPORT nb_status norm_query_select(struct norm_conn *conn,
+					const struct norm_query *query,
+					const struct norm_call *call,
+					struct norm_rows **out,
+					struct norm_error *error);
+NORM_EXPORT nb_status norm_query_cursor_open(struct norm_conn *conn,
+					     const struct norm_query *query,
+					     const struct norm_call *call,
+					     struct norm_cursor **out,
+					     struct norm_error *error);
+/* Source projection fields map positionally to target fields (or all
+ * non-generated target fields when fields is NULL). One atomic statement. */
+NORM_EXPORT nb_status norm_insert_select(
+	struct norm_conn *conn, const struct norm_model *model,
+	const size_t *fields, size_t field_count,
+	const struct norm_query *query, const struct norm_conflict *conflict,
+	const struct norm_call *call, struct norm_write_result *out,
+	struct norm_error *error);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
