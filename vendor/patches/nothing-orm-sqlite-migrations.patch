+	norm_sql_destroy(&sql);
+	return ret;
+}
+
+nb_status norm_insert_select(struct norm_conn *conn,
+			     const struct norm_model *model,
+			     const size_t *fields, size_t field_count,
+			     const struct norm_query *query,
+			     const struct norm_conflict *conflict,
+			     const struct norm_call *call,
+			     struct norm_write_result *out,
+			     struct norm_error *error)
+{
+	struct norm_sql sql;
+	nb_status ret = connection_check(conn, call, error);
+
+	if (ret != NB_OK)
+		return ret;
+	norm_sql_init(&sql);
+	ret = norm_compile_insert_select(norm_conn_driver(conn), model, fields,
+					 field_count, query, conflict, &sql,
+					 error);
+	if (ret == NB_OK)
+		ret = compiled_exec(conn, &sql, call, out, error);
+	norm_sql_destroy(&sql);
+	return ret;
+}
+
+nb_status norm_schema_add_column(struct norm_conn *conn,
+				 const struct norm_model *model,
+				 size_t field_index,
+				 const struct norm_call *call,
+				 struct norm_error *error)
+{
+	struct norm_sql sql;
+	nb_status ret = norm_schema_ready_internal(conn, call, error);
+
+	if (ret != NB_OK)
+		return ret;
+	norm_sql_init(&sql);
+	ret = norm_compile_add_column(norm_conn_driver(conn), model,
+				      field_index, &sql, error);
+	if (ret == NB_OK)
+		ret = compiled_exec(conn, &sql, call, NULL, error);
+	norm_sql_destroy(&sql);
+	return ret;
+}
