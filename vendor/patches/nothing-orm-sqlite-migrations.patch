+nb_status norm_sqlite_detach(struct norm_conn *conn, nb_str schema,
+			     const struct norm_call *call,
+			     struct norm_error *error)
+{
+	struct norm_sqlite_connection *connection;
+	char *name = NULL, *sql;
+	nb_status ret;
+
+	ret = sqlite_extension_connection(conn, call, true, &connection, error);
+	if (ret != NB_OK)
+		return ret;
+	ret = sqlite_attachment_name(schema, &name, error);
+	if (ret != NB_OK)
+		return ret;
+	sql = sqlite3_mprintf("DETACH DATABASE \"%w\"", name);
+	norm_dealloc(name);
+	if (!sql)
+		return sqlite_extension_error(error, NB_ERR_NOMEM,
+					      "allocating detach SQL");
+	ret = sqlite_command(connection, sql, error);
+	sqlite3_free(sql);
+	return ret;
+}
