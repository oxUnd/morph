+				     "invalid function arity or DISTINCT");
+	if (context->sql->literals && function <= NORM_FUNCTION_MAX)
+		return compile_error(error, NB_ERR_UNSUPPORTED, context->driver,
+				     "aggregate in DDL predicate");
+	if ((function == NORM_FUNCTION_TYPEOF ||
+	     function == NORM_FUNCTION_JSON_EXTRACT) &&
+	    context->driver != NORM_DRIVER_SQLITE)
+		return compile_error(error, NB_ERR_UNSUPPORTED, context->driver,
+				     "SQLite scalar function required");
+	if (function == NORM_FUNCTION_NAMED) {
+		ret = norm_sql_identifier(context->sql, context->driver,
+					  term->as.function.name, error);
+		if (ret != NB_OK)
+			return ret;
+	} else {
+		name = names[function];
+		if (context->driver == NORM_DRIVER_SQLITE) {
+			if (function == NORM_FUNCTION_GREATEST)
+				name = "MAX";
+			else if (function == NORM_FUNCTION_LEAST)
+				name = "MIN";
+			else if (function == NORM_FUNCTION_BYTE_LENGTH)
+				name = "LENGTH";
+		}
+		sql_text(context->sql, name);
+	}
+	sql_text(context->sql, "(");
+	if (term->as.function.distinct)
+		sql_text(context->sql, "DISTINCT ");
+	if (function == NORM_FUNCTION_COUNT && !count)
+		sql_text(context->sql, "*");
+	for (i = 0; i < count; i++) {
+		if (i)
+			sql_text(context->sql, ", ");
+		if (function == NORM_FUNCTION_BYTE_LENGTH &&
+		    context->driver == NORM_DRIVER_SQLITE)
+			sql_text(context->sql, "CAST(");
+		ret = render_term(context, &args[i], depth + 1, error);
+		if (ret != NB_OK)
+			return ret;
+		if (function == NORM_FUNCTION_BYTE_LENGTH &&
+		    context->driver == NORM_DRIVER_SQLITE)
+			sql_text(context->sql, " AS BLOB)");
+	}
+	sql_text(context->sql, ")");
+	return sql_status(context->sql, context->driver, error);
+}
+
+static nb_status render_term(struct expression_context *context,
+			     const struct norm_term *term, size_t depth,
+			     struct norm_error *error)
+{
+	static const char *const binary[] = { " + ", " - ", " * ", " / ",
+					      " || " };
+	const struct norm_table_ref *source;
+	struct norm_column column;
+	const char *type;
+	size_t i;
+	nb_status ret;
+
+	if (!term)
+		return compile_error(error, NB_ERR_INVAL, context->driver,
+				     "missing scalar expression");
+	if (expression_limit(context, depth))
+		return compile_error(error, NB_ERR_TOO_BIG, context->driver,
+				     "scalar expression tree limit");
+	switch (term->kind) {
+	case NORM_TERM_COLUMN:
+		return render_column(context, term->as.column, error);
+	case NORM_TERM_VALUE:
+		return norm_sql_param(context->sql, context->driver,
+				      &term->as.value, error);
+	case NORM_TERM_BINARY:
+		if (term->as.binary.operation < NORM_BINARY_ADD ||
+		    term->as.binary.operation > NORM_BINARY_CONCAT)
+			return compile_error(error, NB_ERR_INVAL,
+					     context->driver,
+					     "invalid scalar operator");
+		sql_text(context->sql,
+			 term->as.binary.operation == NORM_BINARY_CONCAT &&
+					 context->driver == NORM_DRIVER_MYSQL
+				 ? "CONCAT("
+				 : "(");
+		ret = render_term(context, term->as.binary.left, depth + 1,
+				  error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(context->sql,
+			 term->as.binary.operation == NORM_BINARY_CONCAT &&
+					 context->driver == NORM_DRIVER_MYSQL
+				 ? ", "
+				 : binary[term->as.binary.operation]);
+		ret = render_term(context, term->as.binary.right, depth + 1,
+				  error);
+		sql_text(context->sql, ")");
+		return ret;
+	case NORM_TERM_FUNCTION:
+		return render_term_function(context, term, depth, error);
+	case NORM_TERM_CASE:
+		if (!term->as.conditional.branches ||
+		    !term->as.conditional.count ||
+		    term->as.conditional.count > 1024)
+			return compile_error(error, NB_ERR_INVAL,
+					     context->driver,
+					     "invalid CASE expression");
+		sql_text(context->sql, "CASE");
+		for (i = 0; i < term->as.conditional.count; i++) {
+			sql_text(context->sql, " WHEN ");
+			ret = render_expression(
+				context, &term->as.conditional.branches[i].when,
+				depth + 1, error);
+			if (ret != NB_OK)
+				return ret;
+			sql_text(context->sql, " THEN ");
+			ret = render_term(context,
+					  term->as.conditional.branches[i].then,
+					  depth + 1, error);
+			if (ret != NB_OK)
+				return ret;
+		}
+		sql_text(context->sql, " ELSE ");
+		if (term->as.conditional.otherwise)
+			ret = render_term(context,
+					  term->as.conditional.otherwise,
+					  depth + 1, error);
+		else {
+			sql_text(context->sql, "NULL");
+			ret = NB_OK;
+		}
+		sql_text(context->sql, " END");
+		return ret;
+	case NORM_TERM_CAST:
+		switch (term->as.cast.type) {
+		case NORM_TYPE_I32:
+			type = context->driver == NORM_DRIVER_MYSQL ? "SIGNED"
+								    : "INTEGER";
+			break;
+		case NORM_TYPE_I64:
+			type = context->driver == NORM_DRIVER_MYSQL ? "SIGNED"
+								    : "BIGINT";
+			break;
+		case NORM_TYPE_BOOL:
+			type = context->driver == NORM_DRIVER_POSTGRESQL
+				       ? "BOOLEAN"
+			       : context->driver == NORM_DRIVER_MYSQL
+				       ? "UNSIGNED"
+				       : "INTEGER";
+			break;
+		case NORM_TYPE_F64:
+			type = context->driver == NORM_DRIVER_SQLITE
+				       ? "REAL"
+				       : "DOUBLE PRECISION";
+			break;
+		case NORM_TYPE_TEXT:
+			type = context->driver == NORM_DRIVER_MYSQL ? "CHAR"
+								    : "TEXT";
+			break;
+		case NORM_TYPE_BLOB:
+			type = context->driver == NORM_DRIVER_POSTGRESQL
+				       ? "BYTEA"
+			       : context->driver == NORM_DRIVER_MYSQL ? "BINARY"
+								      : "BLOB";
+			break;
+		default:
+			return compile_error(error, NB_ERR_UNSUPPORTED,
+					     context->driver,
+					     "unsupported scalar cast");
+		}
+		sql_text(context->sql, "CAST(");
+		ret = render_term(context, term->as.cast.value, depth + 1,
+				  error);
+		sql_text(context->sql, " AS ");
+		sql_text(context->sql, type);
+		sql_text(context->sql, ")");
+		return ret;
+	case NORM_TERM_SCALAR_QUERY:
+		if (!term->as.query || term->as.query->field_count != 1 ||
+		    context->sql->literals)
+			return compile_error(
+				error, NB_ERR_INVAL, context->driver,
+				"scalar query requires one output");
+		sql_text(context->sql, "(");
+		ret = render_query(context, term->as.query, depth + 1, error);
+		sql_text(context->sql, ")");
+		return ret;
+	case NORM_TERM_EXCLUDED:
+		column = term->as.column;
+		if (!context->excluded_model ||
+		    column.model != context->excluded_model || column.source ||
+		    column.index >= column.model->field_count)
+			return compile_error(
+				error, NB_ERR_INVAL, context->driver,
+				"excluded column outside conflict update");
+		sql_text(context->sql, "excluded.");
+		return norm_sql_identifier(
+			context->sql, context->driver,
+			column.model->fields[column.index].column, error);
+	case NORM_TERM_ROWID:
+		source = term->as.rowid;
+		if (context->driver != NORM_DRIVER_SQLITE || !source)
+			return compile_error(error, NB_ERR_UNSUPPORTED,
+					     context->driver,
+					     "rowid requires a SQLite source");
+		column = norm_table_col(source, 0);
+		{
+			size_t mark = nb_buf_len(&context->sql->text);
+			ret = render_column(context, column, error);
+			nb_buf_truncate(&context->sql->text, mark);
+		}
+		if (ret != NB_OK)
+			return ret;
+		ret = norm_sql_identifier(context->sql, context->driver,
+					  source->alias, error);
+		if (ret == NB_OK)
+			sql_text(context->sql, ".rowid");
+		return ret;
+	case NORM_TERM_ROW_NUMBER:
+		if (context->sql->literals ||
+		    term->as.window.partition_count > 4096 ||
+		    (term->as.window.partition_count &&
+		     !term->as.window.partition))
+			return compile_error(error, NB_ERR_INVAL,
+					     context->driver,
+					     "invalid window expression");
+		sql_text(context->sql, "ROW_NUMBER() OVER (");
+		for (i = 0; i < term->as.window.partition_count; i++) {
+			sql_text(context->sql, i ? ", " : "PARTITION BY ");
+			ret = render_term(context,
+					  &term->as.window.partition[i],
+					  depth + 1, error);
+			if (ret != NB_OK)
+				return ret;
+		}
+		if (term->as.window.order_count) {
+			sql_text(context->sql, " ORDER BY ");
+			ret = render_query_order(context, term->as.window.order,
+						 term->as.window.order_count,
+						 depth + 1, error);
+			if (ret != NB_OK)
+				return ret;
+		}
+		sql_text(context->sql, ")");
+		return NB_OK;
+	default:
+		return compile_error(error, NB_ERR_INVAL, context->driver,
+				     "unknown scalar expression");
+	}
+}
+
+static nb_status render_computed_predicate(struct expression_context *context,
+					   const struct norm_expr *expr,
+					   size_t depth,
+					   struct norm_error *error)
+{
+	static const char *const operations[] = {
+		" = ",	" <> ",	  " > ",  " >= ",    " < ",
+		" <= ", " LIKE ", " IS ", " IS NOT "
+	};
+	enum norm_compare op;
+	nb_status ret;
+
+	if (expr->kind == NORM_EXPR_TERMS_COMPARE) {
+		op = expr->as.terms.operation;
+		if (op < NORM_COMPARE_EQ || op > NORM_COMPARE_IS_NOT)
+			return compile_error(error, NB_ERR_INVAL,
+					     context->driver,
+					     "invalid computed comparison");
+		if (context->driver == NORM_DRIVER_MYSQL &&
+		    op == NORM_COMPARE_IS_NOT)
+			sql_text(context->sql, "NOT (");
+		ret = render_term(context, expr->as.terms.left, depth + 1,
+				  error);
+		if (ret != NB_OK)
+			return ret;
+		if (op == NORM_COMPARE_IS || op == NORM_COMPARE_IS_NOT) {
+			sql_text(context->sql,
+				 context->driver == NORM_DRIVER_POSTGRESQL
+					 ? (op == NORM_COMPARE_IS
+						    ? " IS NOT DISTINCT FROM "
+						    : " IS DISTINCT FROM ")
+				 : context->driver == NORM_DRIVER_MYSQL
+					 ? " <=> "
+					 : operations[op]);
+		} else
+			sql_text(context->sql, operations[op]);
+		ret = render_term(context, expr->as.terms.right, depth + 1,
+				  error);
+		if (context->driver == NORM_DRIVER_MYSQL &&
+		    op == NORM_COMPARE_IS_NOT)
+			sql_text(context->sql, ")");
+		if (ret == NB_OK && op == NORM_COMPARE_LIKE)
+			sql_text(context->sql, " ESCAPE '!'");
+		return ret;
+	}
+	if (context->sql->literals)
+		return compile_error(error, NB_ERR_UNSUPPORTED, context->driver,
+				     "subquery in DDL predicate");
+	if (expr->kind == NORM_EXPR_EXISTS) {
+		sql_text(context->sql, "EXISTS (");
+		ret = render_query(context, expr->as.query, depth + 1, error);
+	} else {
+		if (!expr->as.query_in.query ||
+		    expr->as.query_in.query->field_count != 1)
+			return compile_error(error, NB_ERR_INVAL,
+					     context->driver,
+					     "IN query requires one output");
+		ret = render_term(context, expr->as.query_in.value, depth + 1,
+				  error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(context->sql,
+			 expr->as.query_in.negated ? " NOT IN (" : " IN (");
+		ret = render_query(context, expr->as.query_in.query, depth + 1,
+				   error);
+	}
+	sql_text(context->sql, ")");
+	return ret;
+}
+
+static nb_status render_query(struct expression_context *parent,
+			      const struct norm_query *query, size_t depth,
+			      struct norm_error *error)
+{
+	const struct norm_table_ref *sources[64];
+	struct expression_context context = {
+		.sql = parent->sql,
+		.driver = parent->driver,
+		.parent = parent,
+		.sources = sources,
+		.query_depth = parent->query_depth + depth,
+		.node_count = parent->node_count,
+		.excluded_model = parent->excluded_model,
+	};
+	struct norm_join_query source_query = { 0 };
+	const struct norm_cte *cte;
+	const struct norm_join *join;
+	size_t i, j;
+	bool recursive = false, wrap;
+	nb_status ret;
+
+	if (!query || context.query_depth > 64 || query->field_count > 4096 ||
+	    !query->fields || !query->field_count || query->join_count > 63 ||
+	    (query->join_count && !query->joins) ||
+	    (!query->from && query->join_count) ||
+	    (query->with_count && !query->with) || query->with_count > 64 ||
+	    (query->set_count && !query->sets) || query->set_count > 64 ||
+	    (query->group_count && !query->group) ||
+	    query->group_count > 4096 || (query->offset && !query->has_limit))
+		return compile_error(error, NB_ERR_INVAL, context.driver,
+				     "invalid structured query");
+	ret = validate_model(context.driver, query->projection, false, error);
+	if (ret != NB_OK)
+		return ret;
+	if (query->field_count > query->projection->field_count)
+		return compile_error(error, NB_ERR_INVAL, context.driver,
+				     "query has too many output fields");
+	if (query->from) {
+		source_query.from = query->from;
+		source_query.joins = query->joins;
+		source_query.join_count = query->join_count;
+		ret = join_sources(context.driver, &source_query, sources,
+				   error);
+		if (ret != NB_OK)
+			return ret;
+		context.source_count = query->join_count + 1;
+	}
+	for (i = 0; i < query->with_count; i++)
+		recursive = recursive || query->with[i].recursive;
+	if (query->with_count)
+		sql_text(context.sql, recursive ? "WITH RECURSIVE " : "WITH ");
+	for (i = 0; i < query->with_count; i++) {
+		cte = &query->with[i];
+		if (!cte->model || cte->model->schema.len || !cte->query ||
+		    cte->model->field_count != cte->query->field_count)
+			return compile_error(error, NB_ERR_INVAL,
+					     context.driver,
+					     "invalid CTE binding");
+		ret = validate_model(context.driver, cte->model, true, error);
+		if (ret != NB_OK)
+			return ret;
+		for (j = 0; j < i; j++)
+			if (alias_equal(query->with[j].model->table,
+					cte->model->table))
+				return compile_error(error, NB_ERR_INVAL,
+						     context.driver,
+						     "duplicate CTE name");
+		if (i)
+			sql_text(context.sql, ", ");
+		ret = norm_sql_identifier(context.sql, context.driver,
+					  cte->model->table, error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(context.sql, "(");
+		for (j = 0; j < cte->model->field_count; j++) {
+			if (j)
+				sql_text(context.sql, ", ");
+			ret = norm_sql_identifier(context.sql, context.driver,
+						  cte->model->fields[j].column,
+						  error);
+			if (ret != NB_OK)
+				return ret;
+		}
+		sql_text(context.sql, ") AS (");
+		ret = render_query(&context, cte->query, 1, error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(context.sql, ") ");
+	}
+	sql_text(context.sql, query->distinct ? "SELECT DISTINCT " : "SELECT ");
+	for (i = 0; i < query->field_count; i++) {
+		if (query->fields[i].into >= query->projection->field_count)
+			return compile_error(error, NB_ERR_RANGE,
+					     context.driver,
+					     "computed projection index");
+		for (j = 0; j < i; j++)
+			if (query->fields[j].into == query->fields[i].into)
+				return compile_error(
+					error, NB_ERR_INVAL, context.driver,
+					"duplicate computed projection");
+		if (i)
+			sql_text(context.sql, ", ");
+		ret = render_term(&context, &query->fields[i].value, 1, error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(context.sql, " AS ");
+		ret = norm_sql_identifier(
+			context.sql, context.driver,
+			query->projection->fields[query->fields[i].into].column,
+			error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	if (query->from) {
+		sql_text(context.sql, " FROM ");
+		ret = render_source(context.sql, context.driver, query->from,
+				    error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	for (i = 0; i < query->join_count; i++) {
+		join = &query->joins[i];
+		if (join->kind != NORM_JOIN_INNER &&
+		    join->kind != NORM_JOIN_LEFT)
+			return compile_error(error, NB_ERR_INVAL,
+					     context.driver,
+					     "invalid computed JOIN kind");
+		sql_text(context.sql, join->kind == NORM_JOIN_INNER
+					      ? " INNER JOIN "
+					      : " LEFT JOIN ");
+		ret = render_source(context.sql, context.driver, join->table,
+				    error);
+		if (ret != NB_OK)
+			return ret;
+		context.source_count = i + 2;
+		sql_text(context.sql, " ON ");
+		ret = render_expression(&context, &join->on, 1, error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	context.source_count = query->from ? query->join_count + 1 : 0;
+	if (query->where.kind != NORM_EXPR_NONE) {
+		sql_text(context.sql, " WHERE ");
+		ret = render_expression(&context, &query->where, 1, error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	for (i = 0; i < query->group_count; i++) {
+		sql_text(context.sql, i ? ", " : " GROUP BY ");
+		ret = render_term(&context, &query->group[i], 1, error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	if (query->having.kind != NORM_EXPR_NONE) {
+		sql_text(context.sql, " HAVING ");
+		ret = render_expression(&context, &query->having, 1, error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	for (i = 0; i < query->set_count; i++) {
+		if (!query->sets[i].query ||
+		    query->sets[i].query->field_count != query->field_count ||
+		    query->sets[i].operation < NORM_SET_UNION ||
+		    query->sets[i].operation > NORM_SET_UNION_ALL)
+			return compile_error(error, NB_ERR_INVAL,
+					     context.driver,
+					     "invalid set query");
+		sql_text(context.sql, query->sets[i].operation == NORM_SET_UNION
+					      ? " UNION "
+					      : " UNION ALL ");
+		wrap = query->sets[i].query->with_count ||
+		       query->sets[i].query->set_count ||
+		       query->sets[i].query->order_count ||
+		       query->sets[i].query->has_limit;
+		if (wrap)
+			sql_text(context.sql, "SELECT * FROM (");
+		ret = render_query(parent, query->sets[i].query, depth + 1,
+				   error);
+		if (ret != NB_OK)
+			return ret;
+		if (wrap)
+			sql_text(context.sql, ") AS norm_set_branch");
+	}
+	if (query->order_count) {
+		sql_text(context.sql, " ORDER BY ");
+		ret = render_query_order(&context, query->order,
+					 query->order_count, 1, error);
+		if (ret != NB_OK)
+			return ret;
+	}
+	if (query->has_limit) {
+		nb_buf_printf(&context.sql->text, " LIMIT %" PRIu64,
+			      query->limit);
+		if (query->offset)
+			nb_buf_printf(&context.sql->text, " OFFSET %" PRIu64,
+				      query->offset);
+	}
+	return sql_status(context.sql, context.driver, error);
+}
+
+nb_status norm_compile_query(enum norm_driver driver,
+			     const struct norm_query *query,
+			     struct norm_sql *sql, struct norm_error *error)
+{
+	struct expression_context context = { .sql = sql, .driver = driver };
+
+	if (!sql || !valid_driver(driver))
+		return compile_error(error, NB_ERR_INVAL, driver,
+				     "invalid query compiler context");
+	context.node_count = &context.nodes;
+	return render_query(&context, query, 0, error);
+}
+
+static nb_status render_conflict(enum norm_driver driver,
+				 const struct norm_model *model,
+				 const struct norm_conflict *conflict,
+				 struct norm_sql *sql, struct norm_error *error)
+{
+	struct expression_context context = { .sql = sql,
+					      .driver = driver,
+					      .model = model,
+					      .excluded_model = model };
+	const struct norm_assignment *assignment;
+	struct norm_value value;
+	size_t i, j, index;
+	nb_status ret;
+
+	context.node_count = &context.nodes;
+	if (!conflict)
+		return NB_OK;
+	if (driver == NORM_DRIVER_MYSQL)
+		return compile_error(error, NB_ERR_UNSUPPORTED, driver,
+				     "targeted conflict handling requires "
+				     "SQLite or PostgreSQL");
+	if (conflict->action < NORM_CONFLICT_NOTHING ||
+	    conflict->action > NORM_CONFLICT_UPDATE ||
+	    (conflict->field_count && !conflict->fields) ||
+	    conflict->field_count > model->field_count ||
+	    (conflict->action == NORM_CONFLICT_UPDATE &&
+	     (!conflict->field_count || !conflict->set_count ||
+	      !conflict->set)) ||
+	    (conflict->action == NORM_CONFLICT_NOTHING &&
+	     (conflict->set_count || conflict->where.kind != NORM_EXPR_NONE)))
+		return compile_error(error, NB_ERR_INVAL, driver,
+				     "invalid conflict descriptor");
+	sql_text(sql, " ON CONFLICT");
+	if (conflict->field_count) {
+		sql_text(sql, " (");
+		for (i = 0; i < conflict->field_count; i++) {
+			index = conflict->fields[i];
+			if (index >= model->field_count)
+				return compile_error(error, NB_ERR_RANGE,
+						     driver,
+						     "conflict target index");
+			for (j = 0; j < i; j++)
+				if (conflict->fields[j] == index)
+					return compile_error(
+						error, NB_ERR_INVAL, driver,
+						"duplicate conflict target");
+			if (i)
+				sql_text(sql, ", ");
+			ret = norm_sql_identifier(sql, driver,
+						  model->fields[index].column,
+						  error);
+			if (ret != NB_OK)
+				return ret;
+		}
+		sql_text(sql, ")");
+	}
+	if (conflict->action == NORM_CONFLICT_NOTHING) {
+		sql_text(sql, " DO NOTHING");
+		return NB_OK;
+	}
+	sql_text(sql, " DO UPDATE SET ");
+	for (i = 0; i < conflict->set_count; i++) {
+		assignment = &conflict->set[i];
+		if (assignment->column.model != model ||
+		    assignment->column.source ||
+		    assignment->column.index >= model->field_count ||
+		    (model->fields[assignment->column.index].flags &
+		     NORM_FIELD_GENERATED))
+			return compile_error(error, NB_ERR_INVAL, driver,
+					     "invalid conflict assignment");
+		for (j = 0; j < i; j++)
+			if (conflict->set[j].column.index ==
+			    assignment->column.index)
+				return compile_error(
+					error, NB_ERR_INVAL, driver,
+					"duplicate conflict assignment");
+		if (i)
+			sql_text(sql, ", ");
+		ret = render_column(&context, assignment->column, error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(sql, " = ");
+		if (assignment->expression)
+			ret = render_term(&context, assignment->expression, 1,
+					  error);
+		else {
+			ret = norm_convert_value(
+				&assignment->value,
+				model->fields[assignment->column.index].type,
+				NULL, &value, error);
+			if (ret == NB_OK)
+				ret = norm_validate_field_value(
+					&model->fields[assignment->column
+							       .index],
+					&value, error);
+			if (ret == NB_OK)
+				ret = norm_sql_param(sql, driver, &value,
+						     error);
+		}
+		if (ret != NB_OK)
+			return ret;
+	}
+	if (conflict->where.kind != NORM_EXPR_NONE) {
+		sql_text(sql, " WHERE ");
+		return render_expression(&context, &conflict->where, 1, error);
+	}
+	return NB_OK;
+}
+
+nb_status norm_compile_insert_select(enum norm_driver driver,
+				     const struct norm_model *model,
+				     const size_t *fields, size_t field_count,
+				     const struct norm_query *query,
+				     const struct norm_conflict *conflict,
+				     struct norm_sql *sql,
+				     struct norm_error *error)
+{
+	struct norm_query source;
+	nb_vec selected;
+	size_t i, index;
+	nb_status ret;
+
+	if (!sql || !query)
+		return compile_error(error, NB_ERR_INVAL, driver,
+				     "invalid insert-select query");
+	ret = validate_model(driver, model, true, error);
+	if (ret != NB_OK)
+		return ret;
+	nb_vec_init(&selected, sizeof(size_t));
+	ret = selected_fields(model, fields, field_count, true, &selected,
+			      error);
+	if (ret != NB_OK)
+		goto out;
+	if (selected.len != query->field_count || !selected.len) {
+		ret = compile_error(error, NB_ERR_INVAL, driver,
+				    "insert-select projection count differs");
+		goto out;
+	}
+	sql_text(sql, "INSERT INTO ");
+	ret = norm_sql_table(sql, driver, model, error);
+	if (ret != NB_OK)
+		goto out;
+	sql_text(sql, "(");
+	for (i = 0; i < selected.len; i++) {
+		index = *(const size_t *)nb_vec_at(&selected, i);
+		if (i)
+			sql_text(sql, ", ");
+		ret = norm_sql_identifier(sql, driver,
+					  model->fields[index].column, error);
+		if (ret != NB_OK)
+			goto out;
+	}
+	sql_text(sql, ") ");
+	source = *query;
+	/* Keep SQLite's SELECT/ON grammar unambiguous, including compound
+	 * sources. */
+	if (conflict && driver == NORM_DRIVER_SQLITE)
+		sql_text(sql, "SELECT * FROM (");
+	ret = norm_compile_query(driver, &source, sql, error);
+	if (ret == NB_OK && conflict && driver == NORM_DRIVER_SQLITE)
+		sql_text(sql, ") AS norm_insert_source WHERE 1");
+	if (ret == NB_OK)
+		ret = render_conflict(driver, model, conflict, sql, error);
+out:
+	nb_vec_destroy(&selected);
+	return ret;
+}
+
+static nb_status render_literal(struct norm_sql *sql, enum norm_driver driver,
+				const struct norm_value *value,
+				struct norm_error *error)
+{
+	static const char hex[] = "0123456789abcdef";
+	size_t i;
+	unsigned char byte;
+
+	switch (value->type) {
+	case NORM_TYPE_NULL:
+		sql_text(sql, "NULL");
+		break;
+	case NORM_TYPE_BOOL:
+		sql_text(sql, value->as.boolean ? "TRUE" : "FALSE");
+		break;
+	case NORM_TYPE_I32:
+		nb_buf_printf(&sql->text, "%" PRId32, value->as.i32);
+		break;
+	case NORM_TYPE_I64:
+		nb_buf_printf(&sql->text, "%" PRId64, value->as.i64);
+		break;
+	case NORM_TYPE_F64:
+		return norm_append_double_exact(&sql->text, value->as.f64);
+	case NORM_TYPE_TEXT:
+		if (value->as.text.len &&
+		    memchr(value->as.text.ptr, 0, value->as.text.len))
+			return compile_error(error, NB_ERR_UNSUPPORTED, driver,
+					     "NUL in DDL text literal");
+		if (driver == NORM_DRIVER_MYSQL) {
+			sql_text(sql, "CONVERT(X'");
+			for (i = 0; i < value->as.text.len; i++) {
+				byte = (unsigned char)value->as.text.ptr[i];
+				nb_buf_append_char(&sql->text, hex[byte >> 4]);
+				nb_buf_append_char(&sql->text, hex[byte & 15]);
+			}
+			sql_text(sql, "' USING utf8mb4)");
+			break;
+		}
+		sql_text(sql, driver == NORM_DRIVER_POSTGRESQL ? "E'" : "'");
+		for (i = 0; i < value->as.text.len; i++) {
+			byte = (unsigned char)value->as.text.ptr[i];
+			if (byte == '\'' ||
+			    (byte == '\\' && driver == NORM_DRIVER_POSTGRESQL))
+				nb_buf_append_char(&sql->text, (char)byte);
+			nb_buf_append_char(&sql->text, (char)byte);
+		}
+		sql_text(sql, "'");
+		break;
+	default:
+		return compile_error(error, NB_ERR_UNSUPPORTED, driver,
+				     "unsupported DDL literal type");
+	}
+	return sql_status(sql, driver, error);
+}
+
+nb_status norm_compile_add_column(enum norm_driver driver,
+				  const struct norm_model *model,
+				  size_t field_index, struct norm_sql *sql,
+				  struct norm_error *error)
+{
+	static const char *const actions[] = { "RESTRICT", "CASCADE",
+					       "SET NULL", "NO ACTION" };
+	const struct norm_field *field;
+	const struct norm_foreign_key *key;
+	size_t i;
+	nb_status ret;
+
+	if (!sql)
+		return compile_error(error, NB_ERR_INVAL, driver,
+				     "missing add-column SQL output");
+	ret = validate_model(driver, model, true, error);
+	if (ret != NB_OK)
+		return ret;
+	if (field_index >= model->field_count)
+		return compile_error(error, NB_ERR_RANGE, driver,
+				     "add-column index");
+	field = &model->fields[field_index];
+	if ((field->flags & (NORM_FIELD_GENERATED | NORM_FIELD_PRIMARY_KEY)) ||
+	    field->type == NORM_TYPE_VECTOR_F32)
+		return compile_error(error, NB_ERR_UNSUPPORTED, driver,
+				     "adding primary/generated/vector columns "
+				     "is unsupported");
+	sql_text(sql, "ALTER TABLE ");
+	ret = norm_sql_table(sql, driver, model, error);
+	if (ret != NB_OK)
+		return ret;
+	sql_text(sql, " ADD COLUMN ");
+	ret = norm_sql_identifier(sql, driver, field->column, error);
+	if (ret != NB_OK)
+		return ret;
+	sql_text(sql, " ");
+	ret = field_type(sql, driver, field, (nb_str){ 0 }, error);
+	if (ret == NB_OK)
+		ret = field_constraints(sql, driver, field, error);
+	if (ret != NB_OK)
+		return ret;
+	for (i = 0; i < model->foreign_key_count; i++) {
+		key = &model->foreign_keys[i];
+		if (key->field_count != 1 || key->fields[0] != field_index)
+			continue;
+		if (driver == NORM_DRIVER_MYSQL)
+			return compile_error(error, NB_ERR_UNSUPPORTED, driver,
+					     "inline MySQL add-column foreign "
+					     "key is unsupported");
+		sql_text(sql, " REFERENCES ");
+		if (driver == NORM_DRIVER_SQLITE) {
+			if (!nb_str_eq(model->schema.len ? model->schema
+							 : NB_STR_LIT("main"),
+				       key->references->schema.len
+					       ? key->references->schema
+					       : NB_STR_LIT("main")))
+				return compile_error(
+					error, NB_ERR_UNSUPPORTED, driver,
+					"cross-schema SQLite foreign key");
+			ret = norm_sql_identifier(
+				sql, driver, key->references->table, error);
+		} else
+			ret = norm_sql_table(sql, driver, key->references,
+					     error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(sql, "(");
+		ret = norm_sql_identifier(
+			sql, driver,
+			key->references->fields[key->reference_fields[0]]
+				.column,
+			error);
+		if (ret != NB_OK)
+			return ret;
+		sql_text(sql, ") ON DELETE ");
+		sql_text(sql, actions[key->on_delete]);
+		sql_text(sql, " ON UPDATE ");
+		sql_text(sql, actions[key->on_update]);
+	}
+	return sql_status(sql, driver, error);
+}
