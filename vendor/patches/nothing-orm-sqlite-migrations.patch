+		if (order[i].direction < NORM_ASC ||
+		    order[i].direction > NORM_DESC ||
+		    order[i].nulls < NORM_NULLS_NATIVE ||
+		    order[i].nulls > NORM_NULLS_LAST)
+			return compile_error(error, NB_ERR_INVAL,
