+		};
+		struct norm_table_metadata *metadata = NULL;
+		const struct norm_schema_foreign_key_column *foreign;
+
+		OK(norm_schema_create(conn, &child_model, NULL, NULL, &error));
+		OK(norm_schema_read_table(conn, NB_STR_LIT("main"),
+					  child_model.table, NULL, NULL,
+					  &metadata, &error));
+		REQUIRE(norm_table_metadata_foreign_key_count(metadata) == 1);
+		foreign = norm_table_metadata_foreign_key_at(metadata, 0);
+		REQUIRE(nb_str_eq_cstr(foreign->on_update, "NO ACTION"));
+		REQUIRE(nb_str_eq_cstr(foreign->on_delete, "NO ACTION"));
+		norm_table_metadata_free(metadata);
+		OK(norm_model_check_schema(conn, &child_model, NULL, &error));
+	}
+	OK(norm_conn_release(&conn, &error));
+	OK(norm_db_close(&db, NULL, &error));
+}
