+	if (ret != NB_OK)
+		return ret;
+	if (!callback)
+		return sqlite_extension_error(
+			error, NB_ERR_INVAL,
+			"missing regression scalar callback");
+	ret = sqlite_registration_name(name, &text, error);
+	if (ret != NB_OK)
+		return ret;
+	hook = norm_alloc0(sizeof(*hook));
+	if (!hook) {
+		norm_dealloc(text);
+		return sqlite_extension_error(
+			error, NB_ERR_NOMEM,
+			"allocating regression scalar hook");
+	}
+	hook->callback = callback;
+	hook->context = context;
+	int rc = sqlite3_create_function_v2(
+		connection->db, text, 0, SQLITE_UTF8, hook,
