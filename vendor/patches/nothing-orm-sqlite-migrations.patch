+nb_status norm_sqlite_set_trusted_schema(struct norm_conn *conn, bool trusted,
+					 const struct norm_call *call,
+					 struct norm_error *error)
+{
+	struct norm_sqlite_connection *connection;
+	nb_status ret = sqlite_extension_connection(conn, call, true,
+						    &connection, error);
+	int64_t actual;
+
+	if (ret != NB_OK)
+		return ret;
+	ret = sqlite_command(connection,
+			     trusted ? "PRAGMA trusted_schema=ON"
+				     : "PRAGMA trusted_schema=OFF",
+			     error);
+	if (ret == NB_OK)
+		ret = sqlite_integer(connection, "PRAGMA trusted_schema",
+				     &actual, error);
+	if (ret == NB_OK && actual != (trusted ? 1 : 0))
+		ret = sqlite_extension_error(
+			error, NB_ERR_UNSUPPORTED,
+			"SQLite trusted schema setting unavailable");
+	return ret;
