+		if (context->driver != NORM_DRIVER_MYSQL &&
+		    order[i].nulls != NORM_NULLS_NATIVE)
+			sql_text(context->sql,
+				 order[i].nulls == NORM_NULLS_FIRST
+					 ? " NULLS FIRST"
+					 : " NULLS LAST");
