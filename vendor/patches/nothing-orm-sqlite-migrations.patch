+static void sqlite_testing_scalar_invoke(sqlite3_context *context, int count,
+					 sqlite3_value **values)
+{
+	const struct sqlite_testing_scalar *hook = sqlite3_user_data(context);
+	int result;
+
+	(void)count;
+	(void)values;
+	result = hook->callback(hook->context);
+	if (result < 0)
+		sqlite3_result_error(context,
+				     "regression scalar callback failed", -1);
+	else
+		sqlite3_result_int(context, result);
