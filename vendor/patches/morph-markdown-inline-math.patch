+static int inline_flow_flush(struct inline_flow *flow)
+{
+	struct morph_md_kitty *renderer = flow->renderer;
+	struct table_cell_line *line;
+	unsigned int left = renderer->options.content_padding_left_columns;
+	unsigned int start = left + flow->indent;
+	unsigned int edge = content_right_edge(renderer);
+	unsigned int row;
+	unsigned int column;
+	size_t i;
+	int rc;
+
+	if (flow->run.items.len == 0u)
+		return MD_OK;
+
+	rc = table_cell_wrap(&flow->run, edge > start ? edge - start : 1u);
+	renderer->wrap_suppression++;
+	for (i = 0u; rc == MD_OK && i < flow->run.lines.len; i++) {
+		line = md_array_get(&flow->run.lines, i);
+		for (row = 0u; rc == MD_OK && row < (unsigned int)line->height; row++) {
+			if (!renderer->line_started) {
+				rc = renderer_start_content_line(renderer);
+				if (flow->prefix && row == (unsigned int)line->height / 2u) {
+					if (rc == MD_OK)
+						rc = renderer_puts(renderer, flow->prefix);
+				} else {
+					for (column = 0u; rc == MD_OK && column < flow->indent; column++)
+						rc = renderer_putc(renderer, ' ');
+				}
+			}
+
+			if (rc == MD_OK)
+				rc = render_table_cell_line(renderer, line, row);
+
+			if (rc == MD_OK)
+				rc = renderer_newline(renderer);
+		}
+
+		flow->prefix = NULL;
+	}
+
+	renderer->wrap_suppression--;
+	table_cell_cleanup(&flow->run);
+	table_cell_init(&flow->run);
+	flow->emitted = 1;
+	flow->block_spacing = 0;
+	return rc;
+}
