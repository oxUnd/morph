+		rc = renderer_puts(renderer, "\n\n");
+
+	flow->emitted = 1;
+	flow->block_spacing = 1;
+	return rc;
+}
+
+static int inline_flow_collect(struct inline_flow *flow, cmark_node *node,
+			       unsigned int attributes)
+{
+	struct morph_md_kitty *renderer = flow->renderer;
+	cmark_node_type type = cmark_node_get_type(node);
+	const char *kind = cmark_node_get_type_string(node);
+	const char *literal = cmark_node_get_literal(node);
+	struct table_inline_item *item;
+	cmark_node *child;
+	size_t first = flow->run.items.len;
+	size_t i;
+	int rc = MD_OK;
+
+	if (type == MORPH_MD_NODE_MATH_BLOCK)
+		return inline_flow_block(flow, node);
+
+	if (type == CMARK_NODE_IMAGE ||
+	    (type == CMARK_NODE_LINK && !renderer->previewing &&
+	     is_video_path(cmark_node_get_url(node)) && renderer->options.media)) {
+		rc = inline_flow_flush(flow);
+		if (rc == MD_OK)
+			rc = type == CMARK_NODE_IMAGE ? render_image_node(renderer, node) :
+				collect_media(renderer, "video", cmark_node_get_url(node));
+
+		flow->emitted = 1;
+		flow->block_spacing = 0;
+		return rc;
+	}
+
+	if (type == MORPH_MD_NODE_MATH_INLINE && !renderer->previewing) {
+		rc = append_table_math(renderer, &flow->run, node);
+	} else if (type == CMARK_NODE_TEXT || type == MORPH_MD_NODE_MATH_INLINE) {
+		if (type == MORPH_MD_NODE_MATH_INLINE)
+			literal = morph_md_math_literal(node);
+
+		rc = append_table_text(&flow->run, literal ? literal : "");
+	} else if (type == CMARK_NODE_CODE) {
+		rc = append_table_item(&flow->run, TABLE_ITEM_CODE, literal ? literal : "");
+	} else if (type == CMARK_NODE_SOFTBREAK || type == CMARK_NODE_LINEBREAK) {
+		if (flow->run.items.len > 0u &&
+		    (!cmark_node_next(node) ||
+		     cmark_node_get_type(cmark_node_next(node)) != MORPH_MD_NODE_MATH_BLOCK))
+			rc = append_table_item(&flow->run, TABLE_ITEM_BREAK, NULL);
+	} else {
+		if (type == CMARK_NODE_STRONG)
+			attributes |= INLINE_BOLD;
+
+		if (type == CMARK_NODE_EMPH)
+			attributes |= INLINE_ITALIC;
+
+		if (kind && strcmp(kind, "strikethrough") == 0)
+			attributes |= INLINE_STRIKE;
+
+		for (child = cmark_node_first_child(node); rc == MD_OK && child;
+		     child = cmark_node_next(child))
+			rc = inline_flow_collect(flow, child, attributes);
+
+		first = flow->run.items.len;
+		if (rc == MD_OK && type == CMARK_NODE_LINK)
+			rc = append_table_link_destination(&flow->run, cmark_node_get_url(node));
+
+		for (i = first; i < flow->run.items.len; i++) {
+			item = md_array_get(&flow->run.items, i);
+			item->attributes = attributes;
+		}
+
+		return rc;
+	}
+
+	for (i = first; i < flow->run.items.len; i++) {
+		item = md_array_get(&flow->run.items, i);
+		item->attributes = attributes;
+	}
+
+	return rc;
+}
+
+static int contains_math(cmark_node *node)
+{
+	cmark_node *child;
+	cmark_node_type type = cmark_node_get_type(node);
+
+	if (type == MORPH_MD_NODE_MATH_INLINE || type == MORPH_MD_NODE_MATH_BLOCK)
+		return 1;
+
+	for (child = cmark_node_first_child(node); child; child = cmark_node_next(child)) {
+		if (contains_math(child))
+			return 1;
 	}
+
+	return 0;
+}
+
+static int render_math_flow(struct morph_md_kitty *renderer, cmark_node *node)
+{
+	struct inline_flow flow = {0};
+	unsigned int left = renderer->options.content_padding_left_columns;
+	int rc;
+
+	flow.renderer = renderer;
+	flow.indent = renderer->line_started && renderer->content_column > left ?
+		renderer->content_column - left : 0u;
+	flow.prefix = renderer->inline_prefix;
+	renderer->inline_prefix = NULL;
+	if (flow.prefix)
+		flow.indent = (unsigned int)md_utf8_display_width(flow.prefix);
+
+	table_cell_init(&flow.run);
+	rc = inline_flow_collect(&flow, node, 0u);
+	if (rc == MD_OK)
+		rc = inline_flow_flush(&flow);
+
+	if (rc == MD_OK && !flow.block_spacing && renderer->item_depth == 0)
+		rc = renderer_newline(renderer);
+
+	table_cell_cleanup(&flow.run);
 	return rc;
 }
 
