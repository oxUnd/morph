# morph configuration file
# Place at ~/.morph/config.toml
# Environment variables referenced by api_key_env must be set before launch.

[general]
# Default session name on startup
default_session = "default"
# Directory for generated output files
output_dir = "~/.morph/output"
# Log level: debug, info, warn, error
log_level = "info"
# Log file path
log_file = "~/.morph/log/agent.log"

# ──────────────────────────────────────────────
# Text (chat) model
# ──────────────────────────────────────────────
[model.text]
provider    = "openai"
model       = "gpt-4o"
api_base    = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
context_limit    = 128000
# Maximum number of tokens the model is allowed to generate per response.
# Sent as the OpenAI-compatible "max_tokens" field. Default: 4096.
max_tokens       = 4096
timeout_seconds  = 60

# ── Volcengine (火山引擎) example ────────────
# provider    = "volcengine"
# model       = "ep-2025xxxxxxxx-xxxxx"   # Ark endpoint ID
# api_base    = "https://ark.cn-beijing.volces.com/api/v3"
# api_key_env = "VOLCENGINE_API_KEY"
# context_limit = 128000

# ── DeepSeek example ─────────────────────────
# provider    = "deepseek"
# model       = "deepseek-chat"
# api_base    = "https://api.deepseek.com/v1"
# api_key_env = "DEEPSEEK_API_KEY"

# ──────────────────────────────────────────────
# Image generation model
# ──────────────────────────────────────────────
[model.image]
# ── OpenAI DALL-E ─────────────────────────────
# provider    = "openai"
# model       = "dall-e-3"
# api_base    = "https://api.openai.com/v1"
# api_key_env = "OPENAI_API_KEY"

# ── Volcengine seedream (recommended) ─────────
provider    = "volcengine"
model       = "doubao-seedream-5-0-260128"
api_base    = "https://ark.cn-beijing.volces.com/api/v3"
api_key_env = "VOLCENGINE_API_KEY"

# ──────────────────────────────────────────────
# Video generation model
# ──────────────────────────────────────────────
[model.video]
provider            = "volcengine"
model               = ""
api_base            = "https://ark.cn-beijing.volces.com/api/v3"
api_key_env         = "VOLCENGINE_API_KEY"
poll_interval_seconds = 5
poll_timeout_seconds  = 600

[react]
max_iterations      = 15
step_timeout_seconds  = 330
tool_max_retries    = 3
bash_exec_default_timeout = 60
# Enable output quality guardrail.
# When enabled, the agent checks tool execution results before finalizing:
# - All tools failed → retry with specific failed tool names
# - Creative tools called but no output files → retry with guidance
# - Empty answer → retry or force finalize
# Guardrail only triggers when tools were actually called; pure text Q&A
# (no tools used) always passes.
guardrail_enabled   = false
# Maximum number of guardrail-retry cycles per query.
guardrail_max_retries = 2
# Maximum consecutive empty answers before forcing finalization.
guardrail_max_empty_rounds = 2
# Disable specific tools by name. Supported tool names:
# text_gen, text_qa, img_gen, img_edit, img_info, img_resize, img_convert,
# vid_gen, file_read, file_list, file_info
# disabled_tools = ["vid_gen", "img_edit"]

# ── Human-in-the-Loop (HITL) ──────────────────
# When enabled, the agent asks for user confirmation before executing
# certain tools. The user can approve (y), deny (n), or always-approve
# (a) a tool for the rest of the session.
hitl_enabled = false
# List of tool names requiring explicit approval.
# If empty and hitl_enabled is true, ALL tools require approval
# (except read-only tools when hitl_auto_approve_readonly is true).
# hitl_tools = ["bash_exec", "img_edit", "vid_gen"]
# Automatically approve read-only tools (file_read, file_list,
# file_info, img_info, text_qa) without prompting.
hitl_auto_approve_readonly = true

[context]
# Compress when token usage exceeds context_limit * threshold
summarize_threshold_ratio = 0.8
# After compression, target this fraction of context_limit
compress_target_ratio     = 0.5
# Always keep the most recent N conversation rounds
keep_recent_rounds        = 6

[render]
# Image display: auto / kitty / sixel / iterm
prefer_image_protocol = "auto"
mpv_args = "--really-quiet"

[ext]
dir = "~/.morph/exts"
default_max_memory_mb   = 128
default_max_cpu_seconds = 30

[prompt]
# Optional: path to a plain-text file containing additional system prompt
# content appended after the default ReAct system prompt header.
# The file content is inserted before "Available tools:" and the output
# format instructions.
system_prompt_file = ""

# Optional: directory containing multiple prompt fragment files (.txt).
# All files are loaded in alphabetical order and concatenated after
# system_prompt_file (if set). Exts or users can drop prompt files here
# to inject additional instructions into every LLM call.
system_prompt_dir = ""

[skill]
# Optional: custom directory for skills.
# Defaults to ~/.morph/skills/ and ~/.agents/skills/ if empty.
# Skills follow the Agent Skills open standard (agentskills.io).
dir = ""

# ──────────────────────────────────────────────
# MCP (Model Context Protocol) servers
# ──────────────────────────────────────────────
# MCP servers are discovered at startup and their tools/resources/prompts
# are automatically registered as morph tools.
#
# Supported transports:
#   "stdio" — launch a local subprocess (recommended for local servers)
#   "http"  — connect to a remote Streamable HTTP endpoint
#
# Example: Local filesystem server (stdio)
# [[mcp.servers]]
# name           = "filesystem"
# transport      = "stdio"
# command        = "npx"
# args           = ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/dir"]
# auto_connect   = true         # Connect at startup instead of lazy (default: false)
# connect_timeout = 30          # Seconds to wait before giving up (default: 0 = no timeout)
#
# Example: GitHub server (stdio)
# [[mcp.servers]]
# name      = "github"
# transport = "stdio"
# command   = "npx"
# args      = ["-y", "@modelcontextprotocol/server-github"]
# env       = { GITHUB_PERSONAL_ACCESS_TOKEN = "ghp_xxx" }
#
# Example: Remote HTTP server
# [[mcp.servers]]
# name          = "remote-api"
# transport     = "http"
# url           = "https://api.example.com/mcp"
# auth_token_env = "MCP_REMOTE_TOKEN"
#
# Example: Web Search, use exa.ai
# [[mcp.servers]]
# name          = "exa"
# transport     = "http"
# url           = "https://mcp.exa.ai/mcp"
# auto_connect  = true
# connect_timeout = 30
