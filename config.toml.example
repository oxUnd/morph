# morph configuration file
# Place at ~/.morph/config.toml
# Environment variables referenced by api_key_env must be set before launch.

[general]
# Default session name on startup
default_session = "default"
# Directory for generated output files
output_dir = "~/.morph/output"
# Log level: debug, info, warn, error
log_level = "info"
# Log file path
log_file = "~/.morph/log/agent.log"

# ──────────────────────────────────────────────
# Text / vision chat model
# ──────────────────────────────────────────────
[model.text]
# Used by the ReAct loop, text_qa, and img_qa. img_qa requires a
# vision-capable chat model here; [model.image] is only for image generation.
provider    = "openai"
model       = "gpt-4o"
api_base    = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
context_limit    = 128000
# Maximum number of tokens the model is allowed to generate per response.
# Sent as the OpenAI-compatible "max_tokens" field. Default: 4096.
max_tokens       = 4096
# Idle/no-data timeout for one streaming text model request. Default: 300.
timeout_seconds  = 300

# ── Volcengine (火山引擎) example ────────────
# provider    = "volcengine"
# model       = "ep-2025xxxxxxxx-xxxxx"   # Ark endpoint ID
# api_base    = "https://ark.cn-beijing.volces.com/api/v3"
# api_key_env = "VOLCENGINE_API_KEY"
# context_limit = 128000

# ── DeepSeek example ─────────────────────────
# provider    = "deepseek"
# model       = "deepseek-chat"
# api_base    = "https://api.deepseek.com/v1"
# api_key_env = "DEEPSEEK_API_KEY"

# ──────────────────────────────────────────────
# Image generation model
# ──────────────────────────────────────────────
[model.image]
# ── OpenAI DALL-E ─────────────────────────────
# provider    = "openai"
# model       = "dall-e-3"
# api_base    = "https://api.openai.com/v1"
# api_key_env = "OPENAI_API_KEY"

# ── Volcengine seedream (recommended) ─────────
provider    = "volcengine"
model       = "doubao-seedream-5-0-260128"
api_base    = "https://ark.cn-beijing.volces.com/api/v3"
api_key_env = "VOLCENGINE_API_KEY"

# ──────────────────────────────────────────────
# Video generation model
# ──────────────────────────────────────────────
[model.video]
provider            = "volcengine"
model               = ""
api_base            = "https://ark.cn-beijing.volces.com/api/v3"
api_key_env         = "VOLCENGINE_API_KEY"
poll_interval_seconds = 5
poll_timeout_seconds  = 600

[credits]
# Daily credit warning threshold. -1 disables warnings.
daily_limit = -1
currency = "CNY"
# When a model price matches, credits = ceil(estimated_cost * this coefficient).
cost_to_credit_coef = 1000.0
# Fallback coefficients used when no model price is configured.
input_token_credit_coef = 0.0
output_token_credit_coef = 0.0
image_unit_credit_coef = 0.0
video_second_credit_coef = 0.0

# Configure model prices in cost per 1,000,000 units.
# provider/model/kind must match the model usage event exactly. For
# Volcengine Ark endpoints, use the endpoint/model id configured under
# [model.text], [model.image], or [model.video].
# [[credits.prices]]
# provider = "openai"
# model = "gpt-4o"
# kind = "model_text"
# input_per_million = 0.0
# output_per_million = 0.0

# Volcengine prices from the model console. Unit conversion:
# - 元/千 tokens -> per_million = price * 1000
# - 元/张 -> image_unit_per_million = price * 1000000
[[credits.prices]]
provider = "volcengine"
model = "doubao-seed-2-0-lite"
kind = "model_text"
input_per_million = 1.8
output_per_million = 10.8

[[credits.prices]]
provider = "volcengine"
model = "doubao-seedream-5-0-lite"
kind = "model_image"
image_unit_per_million = 220000.0

[[credits.prices]]
provider = "volcengine"
model = "doubao-seedream-4-5"
kind = "model_image"
image_unit_per_million = 250000.0

[[credits.prices]]
provider = "volcengine"
model = "doubao-seedance-1-0-pro-fast-251015"
kind = "model_video"
input_per_million = 4.2
output_per_million = 2.1

[react]
max_iterations      = 15
tool_timeout_seconds  = 300
tool_max_retries    = 3
# Disabled by default because this permits model-initiated process execution.
# When enabled, commands have no network or secret environment access, and
# can write only below their explicit cwd.
bash_exec_enabled = false
bash_exec_default_timeout = 60
# Allowlist patterns. Commands matching one of these run silently.
# Anything NOT matched (and not on the hardcoded dangerous blocklist
# like rm/mv/cp/chmod/curl/wget/ssh/kill/apt/pip/npm/...) triggers an
# interactive y/n/a prompt before execution; "always" persists the
# program name (and resolved cwd) to this session's allowlist.
#
# Pattern syntax for bash_exec_allowed_commands:
#   "*"                  any command (dangerous blocklist still applies)
#   "prog"               any invocation of `prog` (e.g. `prog --help`)
#   "prog *"             any command starting with `prog `
#   "prog sub *"         any command starting with `prog sub `
#   "prog exact args"    exact string match
#
# bash_exec_allowed_commands = [
#   "cmake",                    # any cmake invocation
#   "ctest",                    # any ctest invocation
#   "git",                      # any git invocation
#   "lark-cli",                 # CLI bundled with skills/lark-*
#   "gh pr *",                  # only gh pr subcommands
#   "cmake --build build",      # legacy exact match still works
# ]
#
# bash_exec_allowed_cwds entries are interpreted as subtree roots:
# the requested cwd is allowed if it equals one of these paths or
# resolves to a subdirectory of one. Use "*" to allow any cwd.
# bash_exec_allowed_cwds = ["/absolute/path/to/your/project"]
# Enable output quality guardrail.
# When enabled, the agent checks tool execution results before finalizing:
# - All tools failed → retry with specific failed tool names
# - Creative tools called but no output files → retry with guidance
# - Empty answer → retry or force finalize
# - Creative tool reports missing file → retry with error injected
# Guardrail only triggers when tools were actually called; pure text Q&A
# (no tools used) always passes.
# guardrail_enabled   = false
# Maximum number of guardrail-retry cycles per query.
guardrail_max_retries = 2
# Maximum consecutive empty answers before forcing finalization.
guardrail_max_empty_rounds = 2

## Guardrail: disable specific built-in rules by name.
## Built-in rules: empty_answer, consecutive_empty,
##   tools_all_failed, creative_no_media, creative_file_missing
# guardrail_disabled_rules = ["creative_file_missing"]

## Guardrail: LLM model for semantic checks (uses same api_key as main LLM)
# guardrail_llm_model = "gpt-4o-mini"

## Guardrail: LLM-based semantic rules
## Only suitable for INPUT and OUTPUT hooks (low-frequency).
## The LLM returns {"pass": true/false, "reason": "..."}.
## On timeout or parse failure, defaults to PASS.
# [[react.guardrail_llm_rules]]
# name = "no_pii"
# hook = "input"
# description = "Check if the user input contains personally identifiable information (PII) such as social security numbers, credit card numbers, or private addresses."
# action_text = "Do not include personal identifiable information in your request."

# [[react.guardrail_llm_rules]]
# name = "output_safety"
# hook = "output"
# description = "Check if the proposed answer contains harmful, offensive, or inappropriate content."
# action_text = "Revise your answer to remove any harmful or inappropriate content."

## Guardrail: Ext-based rules
## ──────────────────────────
## Auto-discovery: guardrail exts placed in ~/.morph/exts/ with
##   purpose = "guardrail" in their manifest.toml are automatically
##   registered. No config needed — just install and enable guardrails.
##   The manifest must include: hook, action_text, type, entry.
##
## Manual config (for external scripts not in ~/.morph/exts/):
## ext_type = "exec" (default) — subprocess communicating via JSON-RPC over stdin/stdout
## ext_type = "so" — shared library loaded via dlopen; must export:
##   int guardrail_check(const char *text, const char *rule,
##                       const char *description, char **result_json)
##   result_json must be malloc'd JSON: {"pass":bool,"reason":"..."}
## The subprocess receives JSON-RPC: {"text":"...", "rule":"...", "description":"..."}
## and must return: {"pass": true/false, "reason": "..."}
## On timeout or process failure, defaults to PASS.
# [[react.guardrail_ext_rules]]
# name = "custom_check"
# hook = "output"
# ext_type = "exec"
# ext_entry = "/path/to/guardrail-script"
# action_text = "Revise your answer to pass the custom check."
# Disable specific tools by name. Supported tool names:
# credits, memory, img_gen, img_qa, img_inpaint, img_compose, img_info,
# img_resize, img_convert, img_annotate, vid_gen, file_read, file_list,
# file_info, config_write, bash_exec
# disabled_tools = ["vid_gen", "img_resize"]

# ── Human-in-the-Loop (HITL) ──────────────────
# When enabled, the agent asks for user confirmation before executing
# certain tools. The user can approve (y), deny (n), or always-approve
# (a) a tool for the rest of the session.
hitl_enabled = false
# List of tool names requiring explicit approval.
# If empty and hitl_enabled is true, ALL tools require approval
# (except read-only tools when hitl_auto_approve_readonly is true).
# hitl_tools = ["bash_exec", "img_gen", "vid_gen"]
# Automatically approve read-only tools (file_read, file_list,
# file_info, img_info, credits, memory) without prompting.
hitl_auto_approve_readonly = true

[context]
# Compress when token usage exceeds context_limit * threshold
summarize_threshold_ratio = 0.8
# After compression, target this fraction of context_limit
compress_target_ratio     = 0.5
# Always keep the most recent N conversation rounds
keep_recent_rounds        = 6

[memory]
# Master switch for the agent memory subsystem.
# When disabled, no memories are recorded or injected into the system prompt.
enabled = true
# Hot path: heuristic anchor-based fact extraction.
# Scans user input for phrases like "call me X", "I live in Y",
# "reply in Chinese", "be concise" and upserts facts/procedures
# directly without LLM involvement.
hot_path_enabled = true
# Cold path: episode recording after each turn.
# Stores a structured episode record (task, outcome, tools used, result).
cold_path_enabled = true
# LLM-driven structured extraction.
# Sends the turn to the chat LLM to extract facts, rules, and episode
# metadata as JSON. Silently falls back to anchor heuristics if the
# LLM is unavailable or returns invalid JSON.
llm_extract_enabled = true
# Maximum number of current facts to include in the memory context
# injected into the system prompt. Facts ordered by updated_at DESC.
max_facts = 6
# Maximum number of recent episodes to include in the memory context.
# Only included when the user query contains temporal/episodic phrases
# (e.g. "last time", "previous", "上次", "之前").
max_episodes = 4
# Maximum number of standing rules/procedures to include in the memory
# context. Only included when the user query contains procedure-related
# phrases (e.g. "always", "prefer", "风格").
max_procedures = 4
# Hard character limit on the total memory context string injected into
# the LLM system prompt. Prevents memory from consuming too much of the
# context window.
max_context_chars = 3000

[sync]
# Periodically merge critical files under ~/.morph with a user-chosen
# local sync directory. Deletions are soft-deleted into trash, and
# conflicting edits are kept as conflict copies.
enabled = false
dir = ""
interval_seconds = 300
retention_days = 30
include = ["config.toml", "data.db", "skills", "tools", "exts", "output"]

[render]
# Image display: auto / kitty / sixel / iterm
prefer_image_protocol = "auto"
mpv_args = "--really-quiet"

[ext]
dir = "~/.morph/exts"
default_max_memory_mb   = 128
default_max_cpu_seconds = 30

[dynamic_tools]
# Agent-created JavaScript tools powered by the built-in QuickJS runner.
enabled = true
runtime = "quickjs"
# CLI defaults to local. FastCGI/server defaults to server unless this is set.
mode = "local"              # local | server
session_dir = "~/.morph/runtime/tools"
persistent_dir = "~/.morph/tools"
default_lifetime = "session"
create_requires_approval = false
promote_requires_approval = true
max_source_bytes = 262144
default_timeout_seconds = 30
default_max_output_bytes = 1048576

[dynamic_tools.local]
default_capabilities = ["fs_read", "fs_write", "network", "process", "env", "mcp", "model", "shell", "image", "wasm"]
allowed_read_paths = ["*"]
allowed_write_paths = ["*"]
allowed_commands = ["*"]
allowed_network = ["*"]

[dynamic_tools.server]
default_capabilities = []
allowed_read_paths = []
allowed_write_paths = []
allowed_commands = []
allowed_network = []

[prompt]
# Optional: path to a plain-text file containing additional system prompt
# content appended after the default ReAct system prompt header.
# The file content is inserted before "Available tools:" and the output
# format instructions.
system_prompt_file = ""

# Optional: directory containing multiple prompt fragment files (.txt).
# All files are loaded in alphabetical order and concatenated after
# system_prompt_file (if set). Exts or users can drop prompt files here
# to inject additional instructions into every LLM call.
system_prompt_dir = ""

[skill]
# Optional: custom directory for skills.
# Defaults to ~/.morph/skills/ and ~/.agents/skills/ if empty.
# Skills follow the Agent Skills open standard (agentskills.io).
dir = ""

# ──────────────────────────────────────────────
# MCP (Model Context Protocol) servers
# ──────────────────────────────────────────────
# MCP servers are discovered at startup and their tools/resources/prompts
# are automatically registered as morph tools.
#
# Supported transports:
#   "stdio" — launch a local subprocess (recommended for local servers)
#   "http"  — connect to a remote Streamable HTTP endpoint
#
# Example: Local filesystem server (stdio)
# [[mcp.servers]]
# name           = "filesystem"
# transport      = "stdio"
# command        = "npx"
# args           = ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/dir"]
# auto_connect   = true         # Connect at startup instead of lazy (default: false)
# connect_timeout = 30          # Seconds to wait before giving up (default: 0 = no timeout)
#
# Example: GitHub server (stdio)
# [[mcp.servers]]
# name      = "github"
# transport = "stdio"
# command   = "npx"
# args      = ["-y", "@modelcontextprotocol/server-github"]
# env       = { GITHUB_PERSONAL_ACCESS_TOKEN = "ghp_xxx" }
#
# Example: Remote HTTP server
# [[mcp.servers]]
# name          = "remote-api"
# transport     = "http"
# url           = "https://api.example.com/mcp"
# auth_token_env = "MCP_REMOTE_TOKEN"
#
# Some non-standard MCP servers require the token in the URL. In that case,
# keep the secret in auth_token_env and place ${auth_token} where it belongs.
# The token is URL-encoded before substitution and will not also be sent as a
# Bearer header.
# url           = "https://api.example.com/mcp?api_key=${auth_token}"
# auth_token_env = "MCP_REMOTE_TOKEN"
#
# Example: Web Search, use exa.ai
# connect_timeout = 30

# ──────────────────────────────────────────────
# Sub-Agents
# ──────────────────────────────────────────────
# Sub-agents are specialized agent instances that can be delegated tasks
# by the main agent. Each sub-agent has its own system prompt, tool set,
# and iteration limit.
#
# Tools created for each sub-agent:
#   agent_<name>  — invoke synchronously (blocks until done)
#   delegate      — start asynchronously, returns task_id
#   fanout        — run multiple tasks in parallel
#   agent_status  — check status of async task
#
# Example: Research sub-agent
# [[agent.sub_agents]]
# name = "researcher"
# description = "Deep research and information gathering agent"
# system_prompt_file = "~/.morph/prompts/researcher.md"
# max_iterations = 5
# allowed_tools = ["credits", "memory", "file_read"]
# context_policy = "task_only"        # full | summary | task_only
# merge_strategy = "synthesize"       # synthesize | concat | raw (for fanout)
# output_schema = '{"type":"object","properties":{"findings":{"type":"string"},"sources":{"type":"array","items":{"type":"string"}}},"required":["findings"]}'
#
# Example: Code review sub-agent
# [[agent.sub_agents]]
# name = "reviewer"
# description = "Code review specialist that checks for bugs and style issues"
# system_prompt_file = "~/.morph/prompts/reviewer.md"
# max_iterations = 3
# allowed_tools = ["file_read", "file_list", "file_info", "credits"]
# disabled_tools = ["bash_exec"]
# context_policy = "task_only"
