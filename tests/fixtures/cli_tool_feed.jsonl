{"name": "react.reasoning.delta", "data": {"text": "Checking configuration and endpoint reachability."}}
{"name": "tool.call", "data": {"tool": "exec", "tool_call_id": "1", "args": {"description": "Read MCP configuration", "command": "sed -n '270,310p' ~/.morph/dev.toml"}}}
{"name": "tool.result", "data": {"tool": "exec", "tool_call_id": "1", "result": "{\"ok\": true, \"data\": {\"status\": \"exited\", \"duration_ms\": 200, \"stdout\": \"exa \\u2192 https://mcp.exa.ai/mcp\", \"stderr\": \"\", \"exit_code\": 0}}"}}
{"name": "tool.call", "data": {"tool": "exec", "tool_call_id": "2", "args": {"description": "Check HTTP timeout settings", "command": "rg -n 'CONNECTTIMEOUT|TIMEOUT' src/http/client.c"}}}
